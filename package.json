{
  "name": "agent-loadout",
  "version": "0.4.0",
  "private": true,
  "description": "Declarative manager for skills, agents, hooks, MCP and plugins across Claude Code / Codex profiles",
  "keywords": [
    "claude-code",
    "codex",
    "agents",
    "skills",
    "mcp",
    "dotfiles",
    "cli"
  ],
  "license": "MIT",
  "author": "Andy Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andyhung0723/agent-loadout.git"
  },
  "homepage": "https://github.com/andyhung0723/agent-loadout#readme",
  "type": "module",
  "bin": {
    "loadout": "./bin/loadout.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "smoke:pack": "node scripts/smoke-pack.ts"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
